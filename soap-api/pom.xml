<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dk.library</groupId>
    <artifactId>library-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>soap-api</artifactId>
  <name>Library SOAP API</name>
  <description>SOAP API oven på db-modulet (Jakarta XML Web Services / Metro)</description>

  <dependencies>
    <dependency>
      <groupId>dk.library</groupId>
      <artifactId>db</artifactId>
    </dependency>
    <!-- Jakarta XML Web Services runtime (Metro): API'er, wsgen og Endpoint -->
    <dependency>
      <groupId>com.sun.xml.ws</groupId>
      <artifactId>jaxws-rt</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Genererer WSDL og XSD som filer under build: target/generated-sources/wsdl -->
      <plugin>
        <groupId>com.sun.xml.ws</groupId>
        <artifactId>jaxws-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>gen-wsdl</id>
            <phase>process-classes</phase>
            <goals>
              <goal>wsgen</goal>
            </goals>
            <configuration>
              <sei>dk.library.soap.service.LibraryServiceImpl</sei>
              <genWsdl>true</genWsdl>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Starter serveren med ../mvnw exec:exec fra soap-api/ (WSDL på ?wsdl).
           exec:exec starter en almindelig java-proces. exec:java kører i Mavens egen JVM,
           hvor Metro ikke kan finde sin SAAJ-implementering, når LoggingHandler læser beskeden -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>dk.library.soap.LibraryPublisher</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
