            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/graphql",
        "body": {
          "mode": "raw",
          "raw": "{\"query\": \"mutation { createAuthor(input:{name:\\\"GraphQL demo\\\",surname:\\\"Test\\\"}) { id name surname } }\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"No GraphQL errors\", () => pm.expect(body.errors).to.be.undefined);",
              "if (body.data && body.data.createAuthor) pm.collectionVariables.set(\"authorId\", body.data.createAuthor.id);"
            ]
          }
        }
      ]
    },
