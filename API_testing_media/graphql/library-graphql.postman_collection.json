{
  "info": {
    "name": "Library GraphQL \u2014 complete demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Creates its own demo records and deletes them at the end. Use a database copy for demonstrations."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    }
  ],
  "item": [
    {
      "name": "01 Get book by ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/graphql",
        "body": {
          "mode": "raw",
          "raw": "{\"query\": \"{ bookById(id:1000) { id title publishingYear author { id name surname } publisher { id name } } }\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"No GraphQL errors\", () => pm.expect(body.errors).to.be.undefined);"
            ]
          }
        }
      ]
    },
