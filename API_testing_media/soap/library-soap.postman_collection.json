              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Svaret indeholder <id>\", () => pm.expect(pm.response.text()).to.include(\"<id>\"));",
                  "const match = pm.response.text().match(/<id>(\\d+)<\\/id>/);",
                  "if (match) pm.collectionVariables.set(\"bookId\", match[1]);"
