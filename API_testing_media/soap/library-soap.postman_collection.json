    {
      "name": "WSDL og XSD",
      "description": "Kontrakten, som serveren genererer ud fra Java-klasserne.",
      "item": [
        {
          "name": "WSDL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Indeholder <portType name=\"LibraryPortType\">\", () => pm.expect(pm.response.text()).to.include(\"<portType name=\\\"LibraryPortType\\\">\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?wsdl",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "wsdl",
                  "value": null
                }
              ]
            }
          }
        },
        {
          "name": "XSD",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Indeholder <xs:complexType name=\"Book\">\", () => pm.expect(pm.response.text()).to.include(\"<xs:complexType name=\\\"Book\\\">\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?xsd=1",
              "host": [
                "{{baseUrl}}"
              ],
