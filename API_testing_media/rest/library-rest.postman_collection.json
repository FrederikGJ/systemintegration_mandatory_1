{
  "info": {
    "name": "Library REST API",
    "description": "Alle endpoints i rest-api med tests. Kør hele collectionen i rækkefølge (Run collection): den opretter en forfatter, et forlag og en bog, gemmer deres id'er i collection-variablerne og sletter dem igen til sidst.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Forfattere",
      "description": "/api/authors: create, read by ID, list all, update. Sletning ligger i mappe 4, fordi bogen i mappe 3 bruger forfatteren.",
      "item": [
        {
          "name": "Opret forfatter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Location peger på den nye række\", () => pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/authors/\" + body.id + \"$\")));",
                  "pm.test(\"Body har det nye id og felterne fra requesten\", () => {",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.name).to.eql(\"Karen\");",
                  "    pm.expect(body.surname).to.eql(\"Blixen\");",
                  "});",
                  "pm.collectionVariables.set(\"authorId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/authors",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Karen\",\n    \"surname\": \"Blixen\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Hent forfatter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Body har de forventede felter\", () => {",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"authorId\")));",
                  "    pm.expect(body.name).to.eql(\"Karen\");",
                  "    pm.expect(body.surname).to.eql(\"Blixen\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors/{{authorId}}"
          }
        },
        {
          "name": "List alle forfattere",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Svaret er en liste med alle rækker\", () => pm.expect(list).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Listen indeholder den oprettede række\", () => pm.expect(list.map(x => x.id)).to.include(Number(pm.collectionVariables.get(\"authorId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors"
          }
        },
        {
          "name": "Opdater forfatter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Body har de forventede felter\", () => {",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"authorId\")));",
                  "    pm.expect(body.name).to.eql(\"Tania\");",
                  "    pm.expect(body.surname).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/authors/{{authorId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Tania\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "PUT overskriver hele rækken, så surname bliver null, når den udelades."
          }
        },
        {
          "name": "Fejl: forfatter findes ikke",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Fejlen er Problem Details\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json().detail).to.eql(\"Forfatter \" + pm.collectionVariables.get(\"unknownId\") + \" findes ikke\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors/{{unknownId}}"
          }
        },
        {
          "name": "Fejl: tomt navn",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Fejlen er Problem Details\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json().detail).to.eql(\"Ugyldig request-body\");",
                  "});",
                  "pm.test(\"errors nævner de ugyldige felter\", () => {",
                  "    const errors = pm.response.json().errors.join(\" \");",
                  "    pm.expect(errors).to.include(\"name\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/authors",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"  \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
