    {
      "name": "3 Bøger",
      "description": "/api/books: create, read by ID, list med pagination (limit og offset), update, delete.",
      "item": [
        {
          "name": "Opret bog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Location peger på den nye række\", () => pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/books/\" + body.id + \"$\")));",
                  "pm.test(\"Body har det nye id og felterne fra requesten\", () => {",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.title).to.eql(\"Babettes gæstebud\");",
                  "    pm.expect(body.publishingYear).to.eql(1958);",
                  "    pm.expect(body.authorId).to.eql(Number(pm.collectionVariables.get(\"authorId\")));",
                  "    pm.expect(body.publishingCompanyId).to.eql(Number(pm.collectionVariables.get(\"publisherId\")));",
                  "});",
                  "pm.collectionVariables.set(\"bookId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/books",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Babettes gæstebud\",\n    \"authorId\": {{authorId}},\n    \"publishingYear\": 1958,\n    \"publishingCompanyId\": {{publisherId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Hent bog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Body har de forventede felter\", () => {",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"bookId\")));",
                  "    pm.expect(body.title).to.eql(\"Babettes gæstebud\");",
                  "    pm.expect(body.publishingYear).to.eql(1958);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "List bøger (default: limit 20, offset 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Svaret er en side med limit, offset og total\", () => {",
                  "    pm.expect(page.limit).to.eql(20);",
                  "    pm.expect(page.offset).to.eql(0);",
                  "    pm.expect(page.total).to.be.a(\"number\");",
                  "    pm.expect(page.items).to.be.an(\"array\").with.lengthOf(Math.min(20, Math.max(0, page.total - 0)));",
                  "});",
                  "pm.test(\"Bøgerne er sorteret efter id\", () => {",
                  "    const ids = page.items.map(b => b.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "List bøger (side 3 med 5 pr. side)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Svaret er en side med limit, offset og total\", () => {",
                  "    pm.expect(page.limit).to.eql(5);",
                  "    pm.expect(page.offset).to.eql(10);",
                  "    pm.expect(page.total).to.be.a(\"number\");",
                  "    pm.expect(page.items).to.be.an(\"array\").with.lengthOf(Math.min(5, Math.max(0, page.total - 10)));",
                  "});",
                  "pm.test(\"Bøgerne er sorteret efter id\", () => {",
                  "    const ids = page.items.map(b => b.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books?limit=5&offset=10",
            "description": "offset er antal bøger, der springes over. Side n med limit l har offset (n - 1) * l."
          }
        },
        {
          "name": "List bøger (sidste side)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/books?limit=1\", (err, res) => {",
                  "    pm.collectionVariables.set(\"lastOffset\", res.json().total - 1);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Svaret er en side med limit, offset og total\", () => {",
                  "    pm.expect(page.limit).to.eql(5);",
                  "    pm.expect(page.offset).to.eql(Number(pm.collectionVariables.get(\"lastOffset\")));",
                  "    pm.expect(page.total).to.be.a(\"number\");",
                  "    pm.expect(page.items).to.be.an(\"array\").with.lengthOf(Math.min(5, Math.max(0, page.total - Number(pm.collectionVariables.get(\"lastOffset\")))));",
                  "});",
                  "pm.test(\"Bøgerne er sorteret efter id\", () => {",
                  "    const ids = page.items.map(b => b.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => a - b));",
                  "});",
                  "pm.test(\"Den nye bog er sidst i listen\", () => pm.expect(page.items.at(-1).id).to.eql(Number(pm.collectionVariables.get(\"bookId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books?limit=5&offset={{lastOffset}}",
            "description": "lastOffset sættes af scriptet før requesten: total - 1, så siden kun har den nyeste bog."
          }
        },
        {
          "name": "Opdater bog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Body har de forventede felter\", () => {",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"bookId\")));",
                  "    pm.expect(body.title).to.eql(\"Babette's Feast\");",
                  "    pm.expect(body.publishingYear).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/books/{{bookId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Babette's Feast\",\n    \"authorId\": {{authorId}},\n    \"publishingCompanyId\": {{publisherId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "publishingYear er udeladt, så den bliver null."
          }
        },
        {
